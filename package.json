{
  "name": "eventory",
  "version": "0.0.0",
  "private": true,
  "description": "Eventory — workshop home inventory app (AI-SDLC monorepo skeleton)",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "psql": "docker compose exec db psql -U eventory -d eventory",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage"
  },
  "engines": {
    "node": ">=20"
  }
}
