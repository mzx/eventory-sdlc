{
  "name": "eventory",
  "version": "0.0.0",
  "private": true,
  "description": "Eventory — workshop home inventory app (AI-SDLC monorepo skeleton)",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "psql": "docker compose exec db psql -U eventory -d eventory",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage"
  },
  "engines": {
    "node": ">=20"
  }
}
