# Production image for the web service (EVT-19): builds the SPA as static
# files, then serves them with Caddy — no Node process runs at runtime.
#
# Project is pinned to pnpm 10.x (see root package.json "packageManager"),
# which supports Node >=18; Node 22 is used here to match the web dev
# runtime's minimum supported Node version, not a pnpm requirement.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
RUN pnpm install --frozen-lockfile --filter=@eventory/web...

COPY apps/web ./apps/web
# `apps/web/src/api.ts` defaults every request to relative paths (`/api`,
# `/storage`) precisely so the built bundle works unmodified behind a
# same-origin reverse proxy — no VITE_API_BASE needed here.
RUN pnpm --filter=@eventory/web run build

FROM caddy:2-alpine AS runtime
COPY --from=build /workspace/apps/web/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
