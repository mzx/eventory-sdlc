// Eventory API — Prisma schema
//
// Core inventory domain (EVT-2): Location, Category, Tag, Item, ItemTag, Photo.
// Auth + approval workflow (EVT-14): User, ownership FKs on Item/Photo.
// Projects + BOM (EVT-16): Project, BomLine — workshop projects with a bill of
// materials optionally linked back to inventory items.
// Stock movement ledger (EVT-25): StockMovement — every `Item.quantity` /
// `Item.locationId` change is routed through `StockMovementsService.recordMovement`
// and recorded here as an immutable audit trail (see that service's doc comment).
// Replenishment / personal e-kanban (EVT-26): `Item.minQuantity` + ShoppingListEntry
// — a movement that leaves `quantity <= minQuantity` auto-opens a shopping-list
// entry (StockMovementsService), and a one-tap "Running low" action opens a manual
// one. At most one OPEN entry per item is enforced by a partial unique index added
// by raw SQL in the migration (Prisma's schema DSL has no `@@unique(..., where:)`),
// so `@@unique` is intentionally NOT declared on `ShoppingListEntry` below.
// Containers + license-plate moves (EVT-30): `Location.kind` distinguishes a
// fixed `area` from a movable `container`; a container re-parent is recorded
// as a single itemless `StockMovement` (nullable `itemId`, new `containerId`)
// via `StockMovementsService.recordContainerMove` rather than one row per
// contained item — see `LocationsService.moveContainer`.
// Clear-to-build + kitting (EVT-29): `BomLine.picked` is the pick-list
// check-off state; availability status (ok/short/untracked) is computed
// on read in `ProjectsService.availability` rather than stored.
// Count cadence + opportunistic verification (EVT-27): `Item.lastVerifiedAt`
// + `Item.countIntervalDays` — `countIntervalDays` null means the item is not
// on a count schedule at all ("today's count list" never includes it). Any
// explicit count (blind entry via `ItemsService.count`, or the opportunistic
// "how many are actually left?" prompt riding a consume via
// `ItemsService.consume`) always stamps `lastVerifiedAt`, and records an
// `adjust` movement only when the counted quantity differs from book.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Household-member approval state (EVT-14). New sign-ins start `pending`
/// and are blocked from every route except `/auth/me` until an admin flips
/// them to `approved` (or `rejected`).
enum UserStatus {
  pending
  approved
  rejected
}

/// `admin` can manage users (approve/reject, promote/demote); `user` cannot.
/// The first-ever Google sign-in is auto-promoted to `admin` + `approved`.
enum UserRole {
  user
  admin
}

/// A household member authenticated via Google OAuth.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String?
  picture      String?
  /// Nullable so a row can exist (e.g. a manually-seeded/dev fixture, or a
  /// bootstrap placeholder) without ever having signed in via Google — such
  /// a row must NOT count towards the first-user auto-promotion check (see
  /// `AuthService.upsertFromGoogleProfile`, EVT-20). Real OAuth sign-ins
  /// always populate this.
  googleId     String?    @unique
  status       UserStatus @default(pending)
  role         UserRole   @default(user)
  approvedAt   DateTime?
  approvedById String?    @db.Uuid
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Self-relation: which admin approved/rejected this user.
  approvedBy    User?  @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("UserApprovals")

  createdItems   Item[]          @relation("ItemCreatedBy")
  uploadedPhotos Photo[]         @relation("PhotoUploadedBy")
  // Stock movements this user triggered (EVT-25). Nullable on StockMovement,
  // same rationale as Item.createdById — a deleted user's past movements
  // keep `null` rather than vanishing (onDelete: SetNull).
  stockMovements StockMovement[] @relation("StockMovementCreatedBy")

  @@index([status])
}

/// `area` — a fixed room/shelf/cabinet node (the default; every location
/// predating EVT-30 migrates to this). `container` — a movable box/case:
/// items placed "inside" it just carry it as their `locationId` (contents
/// lookup is already path-based, so this needs no new query shape), and
/// child containers are allowed (a box inside a box). Only `container` nodes
/// support the "Move to…" re-parent flow (`LocationsService.moveContainer`);
/// `area` nodes keep the existing add/rename/delete management flows
/// (EVT-30 non-goal: no re-parenting UI for areas).
enum LocationKind {
  area
  container
}

/// Physical storage location. Self-referencing tree, addressable both by
/// parent/child relation and by a materialized `path` (e.g.
/// "garage.west-wall.cabinet-3") for fast prefix lookups.
model Location {
  id       String       @id @default(uuid()) @db.Uuid
  name     String
  path     String       @unique
  parentId String?      @db.Uuid
  notes    String?
  qrCode   String       @unique @default(uuid())
  kind     LocationKind @default(area)

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")
  items    Item[]

  // Stock movements that departed from / arrived at this location (EVT-25).
  // Two named relations since a single move row references both sides.
  movementsFrom StockMovement[] @relation("StockMovementFromLocation")
  movementsTo   StockMovement[] @relation("StockMovementToLocation")
  // Itemless "container moved" ledger entries where this location IS the
  // container that moved (EVT-30) — distinct from movementsFrom/movementsTo
  // above, which record locations an ITEM moved between.
  containerMovements StockMovement[] @relation("StockMovementContainer")

  @@index([parentId])
  @@index([path])
  @@index([kind])
}

/// Classification tree, same shape as Location minus the QR code (categories
/// are not physically labelled).
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  path     String  @unique
  parentId String? @db.Uuid

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  items    Item[]

  @@index([parentId])
  @@index([path])
}

/// Free-form label, many-to-many with Item via the explicit ItemTag join.
model Tag {
  id    String  @id @default(uuid()) @db.Uuid
  name  String  @unique
  color String?

  items ItemTag[]
}

/// A single inventory item.
model Item {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  quantity       Int      @default(1)
  /// Replenishment threshold (EVT-26). `null` = no replenishment tracking for
  /// this item. When a movement leaves `quantity <= minQuantity`, an open
  /// `low-stock` ShoppingListEntry is created (idempotent — see
  /// StockMovementsService.recordMovement).
  minQuantity    Int?
  /// Count cadence (EVT-27). `null` = this item is not on a count schedule —
  /// it never appears on the verification queue regardless of how stale
  /// `lastVerifiedAt` is. When set, the item is "due" once `lastVerifiedAt +
  /// countIntervalDays` has passed (see `ItemsService.listVerificationQueue`).
  countIntervalDays Int?
  /// When this item was last explicitly counted — via a blind verification
  /// count (`ItemsService.count`) or the opportunistic "how many are
  /// actually left?" prompt (`ItemsService.consume`). `null` = never
  /// verified; treated as due `countIntervalDays` days after `createdAt`.
  lastVerifiedAt DateTime?
  unit           String?
  /// Notion-style free-form attributes (e.g. { "voltage": "12V", "brand": "Bosch" }).
  properties     Json     @default("{}")
  qrCode         String   @unique @default(uuid())
  locationId     String?  @db.Uuid
  categoryId     String?  @db.Uuid
  primaryPhotoId String?  @db.Uuid
  /// Who created this item (EVT-14). Nullable — items predating auth, or
  /// items whose creator was later deleted, keep `null` (SetNull).
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location     Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Named relation to disambiguate from the reverse Photo.item relation below,
  // since Item and Photo reference each other (primary photo vs. photo's owning item).
  primaryPhoto Photo?          @relation("ItemPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)
  photos       Photo[]         @relation("ItemPhotos")
  tags         ItemTag[]
  createdBy    User?           @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Reverse side of BomLine.item (EVT-16). Deleting an item does NOT delete
  // the BOM line — see BomLine.itemId (onDelete: SetNull) — the line keeps
  // its denormalized `name`.
  bomLines     BomLine[]
  // Full movement ledger for this item (EVT-25), newest-first via
  // StockMovementsService.listForItem. Cascades on item delete — itemId is
  // required (not nullable) on StockMovement, so history cannot outlive the
  // item it describes.
  movements    StockMovement[]
  // Shopping-list entries for this item (EVT-26) — at most one `open` at a
  // time (see the partial unique index note above the imports). Cascades on
  // item delete, same rationale as `movements`.
  shoppingListEntries ShoppingListEntry[]

  @@index([locationId])
  @@index([categoryId])
  @@index([name])
  @@index([createdById])
}

/// Explicit Item<->Tag join table (composite PK, cascade on either side).
model ItemTag {
  itemId String @db.Uuid
  tagId  String @db.Uuid

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

/// A photo of an item. Kept even if it's not (or no longer) the item's
/// primary photo, and even if aiAnalysis needs a re-run.
model Photo {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String?  @db.Uuid
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  /// Raw Claude Vision output, kept so analysis can be re-run without re-uploading.
  aiAnalysis   Json?
  /// Who uploaded this photo (EVT-14). Nullable, same rationale as
  /// `Item.createdById`.
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item            Item?  @relation("ItemPhotos", fields: [itemId], references: [id], onDelete: Cascade)
  primaryForItems Item[] @relation("ItemPrimaryPhoto")
  uploadedBy      User?  @relation("PhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([uploadedById])
}

/// A workshop project (EVT-16). Bill-of-materials lines are owned via
/// `BomLine.projectId` (cascade delete).
enum ProjectStatus {
  planned
  in_progress
  completed
  archived
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(planned)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bomLines       BomLine[]
  // Stock movements linked to this project (EVT-25) — e.g. a future BOM
  // backflush (EVT-28) recording `consume` movements against it. Unused by
  // this task's endpoints but the FK exists so that work doesn't need its
  // own migration.
  stockMovements StockMovement[]

  @@index([status])
}

/// A single bill-of-materials line on a Project. May optionally link back to
/// an inventory Item — `name` is denormalized (copied from the item at link
/// time, or typed free-text) so the line still reads sensibly after the
/// linked item is deleted (`itemId` becomes null via `onDelete: SetNull`).
model BomLine {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  itemId    String?  @db.Uuid
  name      String
  quantity  Int      @default(1)
  unit      String?
  notes     String?
  /// Kitting pick-list check-off state (EVT-29 AC 3) — informational only,
  /// not a stock reservation (single-user, EVT-29 non-goal). Persists across
  /// reloads so a paused pick session resumes where it left off.
  picked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([itemId])
}

/// The stock movement ledger (EVT-25) — on-hand (`Item.quantity`) stays the
/// authoritative snapshot for now (see StockMovementsService doc comment on
/// the "ledger vs. snapshot" non-goal), but every change to it is written
/// here first, in the same transaction, so the "where did my M3 screws go?"
/// question always has an answer.
///
/// - `add`     — new stock entering the system (item creation / intake).
/// - `consume` — stock leaving via use; currently unwritten by any endpoint,
///                reserved for a future non-project consumption path.
/// - `move`    — relocation between locations; `delta` is typically 0.
/// - `adjust`  — a manual correction (e.g. editing quantity in the web form).
/// - `build`   — BOM backflush consumption on project completion (EVT-28,
///                `ProjectsService.backflush()`): despite the name, `delta`
///                is NEGATIVE here — completing a project CONSUMES its BOM
///                stock, it doesn't produce it — and `projectId` links back
///                to the completed project. `build` was kept (rather than
///                reusing `consume`) because it's the name the EVT-28 AC
///                specifies and it's what distinguishes "consumed via BOM
///                backflush" from a future generic `consume` write in the
///                ledger; the web UI renders a negative-delta `build` as
///                "Consumed in build" (see `ItemDetailPage`) so it doesn't
///                read as a contradiction.
enum StockMovementKind {
  add
  consume
  move
  adjust
  build
}

model StockMovement {
  id     String            @id @default(uuid()) @db.Uuid
  /// Nullable (EVT-30) — set for every item-quantity/location movement
  /// (`add`/`consume`/`adjust`, and an item-level `move`); null for a
  /// container re-parent movement, which sets `containerId` instead. Exactly
  /// one of `itemId`/`containerId` is populated per row — enforced in
  /// `StockMovementsService`, not by a DB constraint (Prisma has no
  /// cross-column CHECK support here).
  itemId String? @db.Uuid
  /// Set only for a container re-parent movement (EVT-30,
  /// `LocationsService.moveContainer`) — the container `Location` that moved.
  /// Null for every item-level movement.
  containerId    String?           @db.Uuid
  kind           StockMovementKind
  /// Signed change applied to `Item.quantity` (positive for `add`; negative
  /// for `consume` and `build` — see the `StockMovementKind` doc comment
  /// above for why `build`'s delta is negative; either sign for `adjust`;
  /// typically 0 for a pure `move` — always 0 for a container move, which
  /// never touches an Item row).
  delta          Int
  /// Set only on `move` — the location the item/container left. Null for
  /// every other kind.
  fromLocationId String?           @db.Uuid
  /// Set only on `move` — the location the item/container arrived at. Null
  /// for every other kind.
  toLocationId   String?           @db.Uuid
  /// Link to the project this movement is associated with. Set on every
  /// `build` movement written by a backflush confirm (EVT-28); null
  /// otherwise.
  projectId      String?           @db.Uuid
  /// Free-text context (e.g. "Initial intake", "Manual quantity edit").
  note           String?
  /// Who triggered this movement. Nullable — same rationale as
  /// `Item.createdById` (predates auth, or the user was later deleted).
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())

  item         Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// `SetNull`, not `Cascade` (EVT-30 review round 2, finding 4) — deleting a
  /// container must NOT erase its own move-history ledger rows, matching the
  /// "immutable audit trail" contract (EVT-25) and the `SetNull` already
  /// used on `fromLocationId`/`toLocationId` below. `note` is populated with
  /// the container's name at record time (see
  /// `LocationsService.moveContainer`) so a row remains human-readable even
  /// after `containerId` is nulled out by a later container deletion.
  container    Location? @relation("StockMovementContainer", fields: [containerId], references: [id], onDelete: SetNull)
  fromLocation Location? @relation("StockMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("StockMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User?     @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Primary read patterns: GET /api/items/:id/movements and
  // GET /api/locations/:id/movements, both newest first.
  @@index([itemId, createdAt])
  @@index([containerId, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([projectId])
}

/// A shopping-list / replenishment entry (EVT-26) — the personal e-kanban.
/// `open` entries are the shopping list; `done` entries are history.
enum ShoppingListEntryStatus {
  open
  done
}

/// - `manual`    — a "Running low" one-tap action (item detail / scan landing).
/// - `low-stock` — auto-created by `StockMovementsService.recordMovement` when
///   a movement leaves `quantity <= minQuantity`.
enum ShoppingListEntrySource {
  manual
  low_stock @map("low-stock")
}

/// At most one `open` entry per item is enforced at the database level by a
/// partial unique index (`CREATE UNIQUE INDEX ... WHERE status = 'open'`),
/// added via raw SQL in the migration since Prisma's schema DSL has no
/// `@@unique(..., where:)` — see the schema-header note. That's what makes
/// both the auto-trigger and the manual "Running low" button idempotent
/// under concurrent/racing writes (EVT-26 risk).
model ShoppingListEntry {
  id         String                  @id @default(uuid()) @db.Uuid
  itemId     String                  @db.Uuid
  status     ShoppingListEntryStatus @default(open)
  source     ShoppingListEntrySource
  createdAt  DateTime                @default(now())
  resolvedAt DateTime?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Query pattern: GET /api/shopping-list (open entries, oldest first) and
  // the per-item idempotency check both filter/sort on these.
  @@index([itemId])
  @@index([status, createdAt])
}
