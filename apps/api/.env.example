DATABASE_URL=postgresql://eventory:eventory@localhost:5432/eventory?schema=public
PORT=3001
# WEB origin that a QR sticker scan should land on (see GET /api/qr/:token).
# Defaults to https://localhost:5173 when unset. For a phone on the same
# LAN to open the app from a native-camera QR scan, this MUST be the
# machine's LAN-reachable https origin (e.g. https://192.168.1.42:5173 or
# https://my-laptop.local:5173), not localhost — see README.md
# "Phone-on-LAN dev setup" for generating mkcert certs that cover it.
PUBLIC_BASE_URL=https://localhost:5173

# --- Auth (EVT-14) ---------------------------------------------------------
# Google OAuth client credentials. Create an OAuth 2.0 Client ID (Web
# application) in Google Cloud Console; the app boots without these set
# (dev/test), but GET /api/auth/google will fail against Google's endpoint
# until they're real values. NEVER commit real secrets — the operator holds
# them.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match the "Authorized redirect URI" configured on the OAuth
# client in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Signing secret for the session JWT. Falls back to an insecure dev default
# when unset — MUST be set to a long random value in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret
# WEB origin the OAuth callback / logout redirect to (a `rejected` — i.e.
# instance-admin-banned — user lands on ${WEB_BASE}/rejected; everyone else
# lands on ${WEB_BASE} itself). Defaults to http://localhost:5173 when unset.
WEB_BASE=http://localhost:5173
# Operator bootstrap mechanism (EVT-20). Comma-separated allowlist of Google
# account emails that ALWAYS become admin + approved on sign-in, regardless
# of what else is in the User table. Without this, "first ever sign-in
# becomes admin" only counts rows that have actually signed in via Google —
# but if you want a GUARANTEED admin (e.g. your own account, or to recover
# an instance where the bootstrap slot got consumed some other way), set it
# here before signing in, e.g.:
#   EVENTORY_ADMIN_EMAILS=me@example.com,partner@example.com
# NOTE (EVT-42 semantic change): this allowlist controls INSTANCE-ADMIN
# status only (the AdminUsersPage's user list/approve/reject/promote tools)
# — it does NOT gate inventory access. Every signed-in user, admin or not,
# must separately create a Workspace (POST /api/workspaces) or redeem an
# invite (POST /api/invites/:token/redeem) before they can touch
# items/locations/etc. A fresh deployment's first sign-in still needs zero
# env vars set: they auto-promote to instance-admin AND can immediately
# create their own workspace. Unset by default.
EVENTORY_ADMIN_EMAILS=
