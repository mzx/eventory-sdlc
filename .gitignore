# ai-sdlc:runtime-gitignore
.ai-sdlc/state.db
.ai-sdlc/state/
.ai-sdlc/audit.jsonl

# Node / build artifacts
node_modules/
dist/
build/
*.tsbuildinfo

# Prisma
apps/api/prisma/generated/

# Photo upload storage (EVT-6) — Docker volume in prod, local uploads in dev
apps/api/storage/*
!apps/api/storage/.gitkeep

# Env
.env
.env.local
apps/api/.env
apps/web/.env

# Logs
npm-debug.log*
*.log

# OS
.DS_Store

# Claude Code local (machine-specific) settings
.claude/settings.local.json
docker-compose.override.yml
