# ai-sdlc:runtime-gitignore
.ai-sdlc/state.db
.ai-sdlc/state/
.ai-sdlc/audit.jsonl
.ai-sdlc/dispatch/
.ai-sdlc/transcripts/
.ai-sdlc/verdicts/
.ai-sdlc/branch-protection-body.json
artifacts/

# Node / build artifacts
node_modules/
dist/
build/
*.tsbuildinfo

# Prisma
apps/api/prisma/generated/

# mkcert dev HTTPS certs (EVT-18) — machine-specific, never commit key material
apps/web/certs/
apps/api/certs/

# vite-plugin-pwa dev-mode service worker output (EVT-18)
apps/web/dev-dist/

# Photo upload storage (EVT-6) — Docker volume in prod, local uploads in dev
apps/api/storage/*
!apps/api/storage/.gitkeep

# Prod backup artifacts (EVT-33) — never risk a stray `git add -A` committing
# a real Postgres dump or photo tar; the real backups live outside the repo
# tree entirely (BACKUP_DIR default /var/backups/eventory), this is defense
# in depth for anyone testing scripts/prod-backup.sh with a repo-local dir.
backups/

# Env
.env
.env.local
.env.prod
apps/api/.env
apps/web/.env

# Logs
npm-debug.log*
*.log

# OS / IDE
.DS_Store
.idea/

# Test coverage output
coverage/

# Claude Code local (machine-specific) settings
.claude/settings.local.json
docker-compose.override.yml

*storybook.log
storybook-static

# design-sync (claude.ai/design) transient state — durable inputs in .design-sync/ stay committed
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/
apps/web/ds-types/
