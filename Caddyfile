# Eventory production reverse proxy (EVT-19).
#
# Caddy is the single public entrypoint: it terminates TLS, serves the built
# SPA as static files with an index.html fallback (so a hard-refresh on a
# client-side route like /items/123 still resolves — AC2), and reverse
# proxies /api/* and /storage/* to the api service same-origin. Same-origin
# means the browser never needs CORS for normal traffic; the api's CORS
# allow-list (WEB_BASE) exists as a defense-in-depth backstop, not the
# primary mechanism.
#
# SITE_ADDRESS defaults to `localhost`, which gets a self-signed cert from
# Caddy's internal CA (AC1) — browsers will show a trust warning until you
# install that CA locally, which is expected for a bare `docker compose up`.
# For a real deployment: set SITE_ADDRESS *and* TLS_MODE (see
# .env.prod.example) to your public domain / ACME contact email — no
# committed file needs editing (EVT-19 review round 2).
#
# `tls {$TLS_MODE:internal}`: `internal` (the default) is Caddy's special
# keyword for its self-signed internal CA; any other value is treated as an
# ACME contact email and triggers a real, trusted Let's Encrypt certificate
# for SITE_ADDRESS instead.

{$SITE_ADDRESS:localhost} {
	tls {$TLS_MODE:internal}

	encode gzip

	# Baseline security headers (EVT-19 review round 2). `X-Frame-Options`
	# and the CSP `frame-ancestors` directive both block this site from
	# being framed (clickjacking defense-in-depth for the two header
	# conventions browsers support); `Referrer-Policy` avoids leaking full
	# URLs (which may contain QR/scan tokens, EVT-13) to third-party
	# `Link:` targets. `Strict-Transport-Security` only meaningfully takes
	# effect once SITE_ADDRESS/TLS_MODE point at a real, publicly-trusted
	# certificate — browsers ignore/warn around HSTS for the default
	# self-signed `internal` cert, so it's safe to always send.
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:3001
	}

	@storage path /storage/*
	handle @storage {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Plain-HTTP requests (port 80) redirect to HTTPS instead of failing outright
# — useful when a client lands on http://<domain> by habit.
http://{$SITE_ADDRESS:localhost} {
	redir https://{host}{uri} permanent
}
