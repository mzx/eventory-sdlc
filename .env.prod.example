# Env file for `docker compose -f docker-compose.prod.yml up --build` (EVT-19).
#
# Copy to `.env.prod` (gitignored — see .gitignore) and fill in real values
# before deploying. NEVER commit real secrets; this file documents shape
# only.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=eventory
# MUST be filled in — left empty on purpose (EVT-19 review round 2, finding
# 1). Compose's `${POSTGRES_PASSWORD:?}` guard only checks "set and
# non-empty", so a *non-empty* placeholder here (e.g. a repo-committed
# string) would silently pass that guard on a copy-paste deploy and become
# the real production database password — anyone who has read this file in
# git history could connect. Generate a real value, e.g.:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=eventory
# The `eventory`/POSTGRES_USER role above is a full-superuser Postgres
# account by default in the official `postgres` image, and is still what
# `DATABASE_URL` (migrations) uses. As of EVT-44, the API's RUNTIME
# connection (`APP_DATABASE_URL` below) uses a SEPARATE, deliberately
# least-privilege role instead — see docs/operations/tenancy-rls.md.
# MUST be rotated for a real deployment (the EVT-44 migration bakes in a
# placeholder password) — after the first deploy:
#   ALTER ROLE eventory_rls PASSWORD '<strong-random-value>';
# then set the SAME value here:
EVENTORY_RLS_PASSWORD=

# --- Caddy / public site -----------------------------------------------------
# Bare host Caddy terminates TLS for. Defaults to `localhost` (self-signed,
# internal-CA cert — browsers will warn until you trust that CA locally).
# Set this to your real domain (e.g. `eventory.example.com`) for a public
# deployment.
SITE_ADDRESS=localhost

# Controls the `tls` directive's argument in ./Caddyfile — no committed
# file needs editing for a real-domain deploy (EVT-19 review round 2).
# - `internal` (default): self-signed cert from Caddy's internal CA, used
#   for the `localhost` / bare-IP dev/staging case above.
# - Any other value is treated as an ACME contact email address (e.g.
#   `ops@example.com`): Caddy then provisions a real trusted certificate
#   from Let's Encrypt automatically for SITE_ADDRESS, registered under
#   that email.
TLS_MODE=internal

# --- API ----------------------------------------------------------------
# Matches docker-compose.prod.yml's `PORT: ${PORT:-3001}` default — only
# needs setting here if you want a different in-container port.
PORT=3001
# Public origin the whole app is reachable at — MUST match SITE_ADDRESS
# above (with scheme). Used to build QR sticker URLs (GET /api/qr/:token)
# and as the OAuth callback / CORS allow-list origin.
PUBLIC_BASE_URL=https://localhost
WEB_BASE=https://localhost

# Google OAuth client credentials (Google Cloud Console > OAuth 2.0 Client
# ID > Web application). GOOGLE_CALLBACK_URL must exactly match the
# "Authorized redirect URI" configured there.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://localhost/api/auth/google/callback

# Operator bootstrap mechanism (EVT-20). Comma-separated allowlist of Google
# account emails that ALWAYS become admin + approved on sign-in, regardless
# of what else is already in the User table — e.g. a pre-existing seeded row
# that would otherwise consume the count-based "first user" slot. Set this
# to your own email before first sign-in, or at any point to recover an
# already-stuck deployment (set it, restart the api, sign in again).
# NOTE (EVT-42 semantic change): this allowlist controls INSTANCE-ADMIN
# status only — it no longer gates inventory access. Every signed-in user
# (admin or not) must separately create/join a Workspace
# (POST /api/workspaces or redeem an invite) before touching inventory data;
# a fresh deployment's first sign-in can do this immediately with zero env
# vars set.
EVENTORY_ADMIN_EMAILS=

# Sign-in allowlist (EVT-45) — THIS is the one that matters for a public
# deployment: closes open self-registration. Comma-separated exact emails
# and/or `@domain.com` entries; a NEW Google account not listed here is
# refused at the OAuth callback with an "invite-only" page (no User row
# created). Does NOT affect an account that has already signed in before, the
# zero-user bootstrap sign-in (first-ever deploy), an EVENTORY_ADMIN_EMAILS
# match, or anyone presenting a valid unclaimed invite token (an invite IS
# its own authorization — household members you've invited via
# POST /api/workspaces/:id/invites keep working even if not listed here).
# Left EMPTY on purpose, like POSTGRES_PASSWORD/JWT_SECRET above — but unlike
# those, an empty value here does NOT fail closed at boot: it keeps the
# pre-EVT-45 open-registration behavior (any Google account may sign in and
# self-create a workspace) and instead logs a prominent startup warning. For
# ANY public-facing deployment, set this before going live:
#   EVENTORY_ALLOWED_SIGNINS=you@example.com,partner@example.com,@your-family-domain.com
EVENTORY_ALLOWED_SIGNINS=

# Signing secret for the session JWT. MUST be filled in — left empty on
# purpose (EVT-19 review round 2, finding 1; same rationale as
# POSTGRES_PASSWORD above). `resolveJwtSecret()` (apps/api/src/auth/auth.service.ts)
# also refuses to boot with this exact placeholder string, or the built-in
# dev default, when NODE_ENV=production — but don't rely on that backstop:
# fill in a real value. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Anthropic API key for AI-assisted photo intake (search-by-photo, item
# draft generation). Optional: those features degrade gracefully without it.
EVENTORY_ANTHROPIC_KEY=
